# Copy to .env in the install folder and fill in. See DEPLOY.md.

# --- SQL Server (required) ---
# Host name of the SQL Server machine, e.g. DC or HOSPITAL-SRV
SQL_SERVER =
# Named instance, if any (e.g. SQLEXPRESS); leave empty for the default instance
SQL_SERVER_INSTANCE =
SQL_DATABASE = HospitalUser
MAIN_DATABASE = HospitalMain
SQL_USER =
SQL_PASSWORD =

# --- Server ---
# Port the API listens on (default 4040). The mobile app's server URL uses it.
PORT = 4040
# Signs login tokens. Set a long random value per installation and keep it
# across updates: changing it signs every user out.
APP_SECRET =

# --- Optional ---
# APP_MAX_UPLOAD_LIMIT = 50mb
# LOG_DAYS = 10
# APP_NAME = DeCare HMS
# COMPANY_NAME =
# APP_DESCRIPTION =
