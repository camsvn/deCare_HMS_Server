{
  "name": "decare_hms",
  "version": "2026.11.1",
  "description": "DeCare HMS Photo Upload Server",
  "main": "index.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc --project ./tsconfig.json",
    "build:release": "webpack --mode production",
    "start": "SET NODE_ENV=production & node dist",
    "dev:server": "SET `NODE_ENV`=development & nodemon dist",
    "compile:watch": "tsc --project ./tsconfig.json --watch",
    "dev": "concurrently \"npm:dev:server\" \"npm:compile:watch\"",
    "zip:pwsh": "pwsh.exe -NoProfile -File scripts/bundle.ps1",
    "bundle:release": "npm run build:release && npm run zip:pwsh"
  },
  "author": "Amal Salvin Joseph",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.3",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0",
    "node-cron": "^4.6.0",
    "sequelize": "^6.37.8",
    "tedious": "^20.3.9"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.19.2",
    "concurrently": "^10.0.7",
    "dotenv-webpack": "^9.0.0",
    "nodemon": "^3.1.14",
    "terser-webpack-plugin": "^5.6.1",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "typescript": "~5.9",
    "webpack": "^5.112.2",
    "webpack-cli": "^7.3.1",
    "webpack-node-externals": "^3.0.0"
  }
}
